<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's task bar is visible -->
    <style name="LaunchTheme" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI. -->
    <style name="NormalTheme" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:attr/windowBackground</item>
    </style>
</resources>
